{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ticketmaster Discovery Classifications API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apikey",
      "value": "{{apikey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Classifications",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search Classifications",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.ticketmaster.com/discovery/v2/classifications.json",
            "params": [
              {
                "name": "apikey",
                "value": "",
                "type": "query"
              },
              {
                "name": "keyword",
                "value": "",
                "type": "query"
              },
              {
                "name": "size",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Browse event segments, genres, and sub-genres available on Ticketmaster."
        }
      ]
    }
  ],
  "bundled": true
}